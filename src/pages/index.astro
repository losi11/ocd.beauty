---
import { Image } from "astro:assets";
import bannerImage from "@assets/banner.png";
import Service from "@components/service.astro";
import Layout from "@layouts/layout.astro";
---

<Layout>
  <main class="flex min-h-screen flex-col items-center justify-center p-6">
    <div class="flex w-full max-w-sm flex-col gap-5">
      <header class="flex flex-col items-center text-center">
        <h1
          class="my-1 text-5xl leading-none tracking-normal text-[#f4f4f5] lowercase sm:text-6xl"
        >
          losi<span class="text-zinc-600">.</span>
        </h1>
        <p
          class="mt-1 cursor-default text-base tracking-wider text-zinc-400 transition-colors duration-150 hover:text-white sm:text-lg"
        >
          ★〜（ゝ。∂）
        </p>
      </header>

      <div class="w-full overflow-hidden">
        <Image
          alt="illustration"
          class="pointer-events-none block h-auto w-full select-none"
          decoding="async"
          format="avif"
          loading="eager"
          quality={80}
          src={bannerImage}
        />
      </div>

      <nav
        class="flex flex-col divide-y divide-dotted divide-zinc-800 border border-dotted border-zinc-800 bg-[#000000]"
      >
        <Service icon="forgejo" name="Forgejo" url="https://git.ocd.beauty" />
        <Service
          icon="navidrome"
          name="Navidrome"
          url="https://music.ocd.beauty"
        />
        <Service
          icon="woodpecker-ci"
          name="Woodpecker CI"
          url="https://ci.ocd.beauty"
        />
      </nav>
    </div>
  </main>
</Layout>
