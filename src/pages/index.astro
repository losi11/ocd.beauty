---
import { Image } from "astro:assets";
import bannerImage from "@assets/banner.png";
import About from "@components/about.astro";
import Footer from "@components/footer.astro";
import Gpg from "@components/gpg.astro";
import Logo from "@components/logo.astro";
import Noise from "@components/noise.astro";
import Scrobble from "@components/scrobble.astro";
import Section from "@components/section.astro";
import Service from "@components/service.astro";
import Layout from "@layouts/layout.astro";

const lastFmUser = process.env.PUBLIC_LAST_FM_USER;
const lastFmApiKey = process.env.PUBLIC_LAST_FM_API_KEY;

if (!(lastFmApiKey && lastFmUser)) {
  return;
}
---

<Layout>
  <Noise />

  <main
    class="relative z-10 flex min-h-dvh flex-col items-center px-4 py-12 sm:py-16"
  >
    <div
      class="my-auto flex w-full max-w-sm flex-col gap-5 border-2 border-black bg-black p-5 sm:p-6 shadow-2xl"
    >
      <Logo />

      <Image
        alt="illustration"
        class="pointer-events-none block h-auto w-full select-none"
        decoding="async"
        format="avif"
        loading="eager"
        quality={80}
        src={bannerImage}
      />

      <Section title="About">
        <About />
      </Section>

      <Section title="Self-hosted">
        <nav
          class="flex flex-col divide-y divide-dotted divide-zinc-800 border border-dotted border-zinc-800 bg-black"
        >
          <Service
            icon="beszel"
            name="Beszel"
            url="https://vmi3530434.taile3bcce.ts.net:8090"
          />
          <Service
            icon="dozzle"
            name="Dozzle"
            url="https://vmi3530434.taile3bcce.ts.net:8080"
          />
          <Service icon="forgejo" name="Forgejo" url="https://git.ocd.beauty" />
          <Service
            icon="navidrome"
            name="Navidrome"
            url="https://music.ocd.beauty"
          />
          <Service
            icon="woodpecker-ci"
            name="Woodpecker CI"
            url="https://ci.ocd.beauty"
          />
        </nav>
      </Section>

      <Section title="GPG">
        <Gpg
          fingerprint="4A91 2E74 5BC1 0F98 3D82 61A4 C8E9 7B3F 252F 7A8D"
          keyId="0x252F7A8D"
        />
      </Section>

      <Section title="Last.fm">
        <Scrobble apiKey={lastFmApiKey} username={lastFmUser} />
      </Section>

      <Footer repo="losi11/ocd.beauty" />
    </div>
  </main>
</Layout>
