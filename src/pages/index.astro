---
import { Image } from "astro:assets";
import bannerImage from "@assets/banner.png";
import Service from "@components/service.astro";
import Layout from "@layouts/main-layout.astro";
---

<Layout title="losi">
  <main class="min-h-screen flex flex-col items-center justify-center p-6">
    <div class="w-full max-w-sm flex flex-col gap-5">
      <header class="text-center flex flex-col items-center">
        <h1
          class="text-5xl sm:text-6xl text-[#f4f4f5] lowercase leading-none my-1 tracking-normal"
        >
          losi<span class="text-zinc-600">.</span>
        </h1>
        <p
          class="text-base sm:text-lg text-zinc-400 hover:text-white transition-colors duration-150 cursor-default tracking-wider mt-1"
        >
          ★〜（ゝ。∂）
        </p>
      </header>

      <div class="w-full overflow-hidden">
        <Image
          alt="illustration"
          class="w-full h-auto block select-none pointer-events-none"
          decoding="async"
          format="avif"
          loading="eager"
          quality={80}
          src={bannerImage}
        />
      </div>

      <nav
        class="flex flex-col border border-dotted border-zinc-800 divide-y divide-dotted divide-zinc-800 bg-[#000000]"
      >
        <Service icon="forgejo" name="Forgejo" url="https://git.ocd.beauty" />
        <Service
          icon="navidrome"
          name="Navidrome"
          url="https://music.ocd.beauty"
        />
        <Service
          icon="woodpecker-ci"
          name="Woodpecker CI"
          url="https://ci.ocd.beauty"
        />
      </nav>
    </div>
  </main>
</Layout>
