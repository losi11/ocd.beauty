---
interface Props {
  apiKey: string;
  username: string;
}

const { username, apiKey } = Astro.props;
---

<div
  class="hidden w-full flex-col divide-y divide-dotted divide-zinc-800 border border-dotted border-zinc-800 bg-[#000000]"
  data-key={apiKey}
  data-user={username}
  id="lastfm-container"
></div>

<script>
  interface LastFmImage {
    "#text": string;
    size: string;
  }

  interface LastFmTrack {
    "@attr"?: { nowplaying: string };
    artist: { "#text": string };
    date?: { uts: string; "#text": string };
    image: LastFmImage[];
    name: string;
    url: string;
  }

  function formatTimeAgo(uts?: string): string {
    if (!uts) {
      return "[recent]";
    }
    const diffSec = Math.floor(Date.now() / 1000 - Number(uts));
    if (diffSec < 60) {
      return "[just now]";
    }
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) {
      return `[${diffMin}m ago]`;
    }
    const diffHours = Math.floor(diffMin / 60);
    if (diffHours < 24) {
      return `[${diffHours}h ago]`;
    }
    const diffDays = Math.floor(diffHours / 24);
    return `[${diffDays}d ago]`;
  }

  async function loadRecentTracks() {
    const container = document.getElementById("lastfm-container");
    if (!container) {
      return;
    }

    const { user, key } = container.dataset;

    if (!(user && key)) {
      return;
    }

    const url = `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${encodeURIComponent(
      user
    )}&api_key=${encodeURIComponent(key)}&format=json&limit=5`;

    try {
      const res = await fetch(url, { cache: "no-store" });
      if (!res.ok) {
        return;
      }

      const data = await res.json();
      const rawTracks = data?.recenttracks?.track;
      if (!rawTracks) {
        return;
      }

      const tracks: LastFmTrack[] = Array.isArray(rawTracks)
        ? rawTracks.slice(0, 5)
        : [rawTracks];

      container.innerHTML = tracks
        .map((track) => {
          const isPlaying = track["@attr"]?.nowplaying === "true";
          const artist = track.artist?.["#text"] ?? "";
          const name = track.name ?? "";
          const trackUrl = track.url ?? "#";
          const timeLabel = isPlaying
            ? "[NOW]"
            : formatTimeAgo(track.date?.uts);

          const cover =
            track.image?.find((img) => img.size === "small")?.["#text"] ||
            track.image?.[0]?.["#text"] ||
            "";

          return `
            <a
              href="${trackUrl}"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-13 items-center justify-between px-4 transition-colors duration-150 hover:bg-[#0c0c0e]"
            >
              <div class="flex min-w-0 items-center gap-3.5 pr-2">
                ${
                  cover
                    ? `<img src="${cover}" alt="cover" class="h-6 w-6 shrink-0 rounded-xs bg-zinc-900 object-cover select-none pointer-events-none" loading="lazy" />`
                    : `<div class="h-6 w-6 shrink-0 rounded-xs bg-zinc-900 flex items-center justify-center text-[11px] text-zinc-600 font-ibm-plex-mono">♪</div>`
                }
                <div class="flex flex-col min-w-0 justify-center">
                  <span class="truncate text-xs text-zinc-200 leading-tight group-hover:text-white transition-colors">
                    ${name}
                  </span>
                  <span class="truncate text-[10px] text-zinc-500 leading-tight mt-0.5">
                    ${artist}
                  </span>
                </div>
              </div>

              <!-- Явный font-ibm-plex-mono и цвет text-zinc-600 -->
              <div class="font-ibm-plex-mono flex shrink-0 items-center gap-1.5 text-xs leading-none">
                ${
                  isPlaying
                    ? `
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      <span class="text-emerald-400">[NOW]</span>
                    `
                    : `<span class="text-zinc-600">${timeLabel}</span>`
                }
              </div>
            </a>
          `;
        })
        .join("");

      container.classList.remove("hidden");
      container.classList.add("flex");
    } catch {
      console.log("ERror");
    }
  }

  loadRecentTracks();
</script>
