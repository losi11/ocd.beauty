---
import forgejo from "@assets/forgejo.svg?raw";
import navidrome from "@assets/navidrome.svg?raw";
import woodpeckerCi from "@assets/woodpecker-ci.svg?raw";
import ServiceStatus from "@components/service-status.astro";

const icons: Record<string, string> = {
  forgejo,
  navidrome,
  "woodpecker-ci": woodpeckerCi,
};

interface Props {
  icon: keyof typeof icons | (string & {});
  name: string;
  url: string;
}

const { icon, name, url } = Astro.props;
const iconSvg = icons[icon] ?? icon;
---

<a
  class="group flex items-center justify-between px-4 py-3 hover:bg-[#0c0c0e] transition-colors duration-150 cursor-pointer"
  href={url}
  rel="noopener noreferrer"
  target="_blank"
>
  <div class="flex items-center gap-3.5">
    <span
      class="w-6 h-6 text-zinc-500 group-hover:text-white transition-colors shrink-0 [&>svg]:w-full [&>svg]:h-full"
      set:html={iconSvg}
    />
    <span
      class="text-xl sm:text-2xl text-zinc-200 group-hover:text-white transition-colors tracking-wide leading-none pt-1"
    >
      {name}
    </span>
  </div>

  <div class="flex items-center gap-1.5 text-lg leading-none pt-1">
    <ServiceStatus url={url} server:defer>
      <span class="text-zinc-700" slot="fallback">[...]</span>
    </ServiceStatus>
  </div>
</a>
