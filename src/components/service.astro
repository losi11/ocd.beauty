---
import forgejo from "@assets/forgejo.svg?raw";
import navidrome from "@assets/navidrome.svg?raw";
import woodpeckerCi from "@assets/woodpecker-ci.svg?raw";
import ServiceStatus from "@components/service-status.astro";

const icons: Record<string, string> = {
  forgejo,
  navidrome,
  "woodpecker-ci": woodpeckerCi,
};

interface Props {
  icon: keyof typeof icons | (string & {});
  name: string;
  url: string;
}

const { icon, name, url } = Astro.props;
const iconSvg = icons[icon] ?? icon;
---

<a
  class="group flex cursor-pointer items-center justify-between px-4 py-3 transition-colors duration-150 hover:bg-[#0c0c0e]"
  href={url}
  rel="noopener noreferrer"
  target="_blank"
>
  <div class="flex items-center gap-3.5">
    <span
      class="h-6 w-6 shrink-0 text-zinc-500 transition-colors group-hover:text-white [&>svg]:h-full [&>svg]:w-full"
      set:html={iconSvg}
    />
    <span
      class="pt-1 text-xl leading-none tracking-wide text-zinc-200 transition-colors group-hover:text-white sm:text-2xl"
    >
      {name}
    </span>
  </div>

  <div class="flex items-center gap-1.5 pt-1 text-lg leading-none">
    <ServiceStatus url={url} server:defer>
      <span class="text-zinc-700" slot="fallback">[...]</span>
    </ServiceStatus>
  </div>
</a>
