---
import beszel from "@assets/beszel.svg?raw";
import dozzle from "@assets/dozzle.svg?raw";
import forgejo from "@assets/forgejo.svg?raw";
import navidrome from "@assets/navidrome.svg?raw";
import woodpeckerCi from "@assets/woodpecker-ci.svg?raw";
import ServiceStatus from "@components/service-status.astro";

const icons: Record<string, string> = {
  beszel,
  dozzle,
  forgejo,
  navidrome,
  "woodpecker-ci": woodpeckerCi,
};

interface Props {
  icon: keyof typeof icons | (string & {});
  name: string;
  url: string;
}

const { icon, name, url } = Astro.props;
const iconSvg = icons[icon] ?? icon;

const displayUrl = url.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<a
  class="group flex h-13 items-center justify-between px-4 transition-colors duration-150 hover:bg-[#0c0c0e]"
  href={url}
  rel="noopener noreferrer"
  target="_blank"
>
  <div class="flex min-w-0 items-center gap-3.5 pr-2">
    <span
      class="h-6 w-6 shrink-0 text-zinc-500 transition-colors group-hover:text-white [&>svg]:h-full [&>svg]:w-full"
      set:html={iconSvg}
    />
    <div class="flex min-w-0 flex-col justify-center">
      <span
        class="truncate text-base leading-tight tracking-wide text-zinc-200 transition-colors group-hover:text-white"
      >
        {name}
      </span>
      <span class="truncate text-[10px] leading-tight text-zinc-500 mt-0.5">
        {displayUrl}
      </span>
    </div>
  </div>

  <div
    class="font-ibm-plex-mono flex shrink-0 items-center gap-1.5 text-xs leading-none"
  >
    <ServiceStatus url={url} server:defer>
      <span class="text-zinc-600" slot="fallback">[...]</span>
    </ServiceStatus>
  </div>
</a>
