---
import { Font } from "astro:assets";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<link href="/sitemap-index.xml" rel="sitemap">
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<meta content="losi" name="description">
<meta content="losi" property="og:title">
<meta content="website" property="og:type">
<meta content="https://ocd.beauty" property="og:url">
<meta content="losi" property="og:description">
<meta
  content="https://www.example.com/_astro/seo-banner.BZD7kegZ.webp"
  property="og:image"
>
<meta content="losi" property="og:image:alt">
<title>{title}</title>
<Font cssVariable="--font-barriecito" preload />
