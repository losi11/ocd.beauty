---
interface Props {
  pingUrl?: string;
  url: string;
}

const { url, pingUrl = url } = Astro.props;

let isUp = false;
let latency = 0;

const start = performance.now();

try {
  const response = await fetch(pingUrl, {
    headers: {
      "User-Agent": "Astro-Homelab-Ping/1.0",
    },
    method: "GET",
    signal: AbortSignal.timeout(2500),
  });

  latency = Math.round(performance.now() - start);
  isUp = response.status < 500;
} catch {
  isUp = false;
}
---

{isUp ? (
    <span class="text-zinc-600">
      [<span class="text-emerald-500">UP:</span> {latency}ms]
    </span>
  ) : (
    <span class="text-zinc-600">
      [<span class="text-rose-500">DOWN:</span>]
    </span>
  )}
