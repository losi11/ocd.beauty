---
import { execSync } from "node:child_process";

interface Props {
  repo: string;
}

const { repo } = Astro.props;

let commit = process.env.COMMIT_HASH || "dev";

if (commit === "dev") {
  try {
    commit = execSync("git rev-parse --short HEAD").toString().trim();
  } catch {
    console.log("Error");
  }
}

const commitUrl = `https://github.com/${repo}/commit/${commit}`;
---

<footer
  class="mt-4 flex flex-col items-center gap-1.5 font-ibm-plex-mono text-xs text-zinc-500"
>
  <div class="flex items-center gap-1">
    <span>built with</span>
    <a
      class="text-zinc-300 transition-colors hover:text-white"
      href="https://astro.build"
      rel="noopener noreferrer"
      target="_blank"
    >
      Astro
    </a>
    <span>and</span>
    <a
      class="text-zinc-300 transition-colors hover:text-white"
      href="https://tailwindcss.com"
      rel="noopener noreferrer"
      target="_blank"
    >
      TailwindCSS
    </a>
  </div>

  <div class="flex items-center gap-1 text-[11px] text-zinc-600">
    <span>commit:</span>
    <a
      class="text-zinc-400 transition-colors hover:text-zinc-200"
      href={commit === "dev" ? `https://github.com/${repo}` : commitUrl}
      rel="noopener noreferrer"
      target="_blank"
    >
      [{commit}]
    </a>
  </div>
</footer>
