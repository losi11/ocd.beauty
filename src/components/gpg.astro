---
interface Props {
  fingerprint: string;
  keyId?: string;
  keyUrl?: string;
}

const {
  keyId = "0x8F2A3B4C",
  fingerprint = "E1A2 B3C4 D5E6 F708 9012 3456 789A BCDE F012 3456",
} = Astro.props;
---

<div class="border border-dotted border-zinc-800 bg-[#000000]">
  <button
    class="group flex h-13 w-full cursor-pointer items-center justify-between px-4 text-left transition-colors duration-150 hover:bg-[#0c0c0e]"
    data-fingerprint={fingerprint.replace(/\s+/g, "")}
    id="gpg-copy-btn"
    title="Click to copy fingerprint"
    type="button"
  >
    <div class="flex min-w-0 items-center gap-3.5 pr-2">
      <svg
        class="h-6 w-6 shrink-0 text-zinc-500 transition-colors group-hover:text-white"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        viewBox="0 0 24 24"
      >
        <title>gpg</title>
        <path
          d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>

      <div class="flex min-w-0 flex-col justify-center">
        <span
          class="truncate text-base leading-tight tracking-wide text-zinc-200 transition-colors group-hover:text-white"
        >
          {keyId}
        </span>
        <span
          class="font-ibm-plex-mono truncate text-[10px] leading-tight text-zinc-500 mt-0.5"
        >
          {fingerprint}
        </span>
      </div>
    </div>

    <div
      class="font-ibm-plex-mono flex shrink-0 items-center gap-1.5 text-xs leading-none"
    >
      <span
        class="text-zinc-600 transition-colors group-hover:text-zinc-400"
        id="gpg-status-tag"
      >
        [COPY]
      </span>
    </div>
  </button>
</div>

<script>
  const btn = document.getElementById("gpg-copy-btn");
  const tag = document.getElementById("gpg-status-tag");

  btn?.addEventListener("click", async () => {
    const textToCopy = btn.dataset.fingerprint ?? "";
    try {
      await navigator.clipboard.writeText(textToCopy);
      if (tag) {
        tag.textContent = "[COPIED]";
        tag.classList.add("text-emerald-500");
        tag.classList.remove("text-zinc-600", "group-hover:text-zinc-400");

        setTimeout(() => {
          tag.textContent = "[COPY]";
          tag.classList.remove("text-emerald-500");
          tag.classList.add("text-zinc-600", "group-hover:text-zinc-400");
        }, 1500);
      }
    } catch {
      console.log("ErrorÏ");
    }
  });
</script>
